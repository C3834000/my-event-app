# העתיקו את המשתנים האלה ל-Netlify → Site settings → Environment variables
# (לא לקובץ במאגר!)

# --- ימות המשיח ---
# מפתח API קבוע מ"אבטחה → ניהול מפתחות גישה" (חומת האש), מוגבל לשירותים GetIncomingCalls + CallAction בלבד
YEMOT_API_KEY=
# מספר השלוחה של חדר הוועידה (למשל 1 או 2/5)
YEMOT_CONF_ROOM=1

# --- Supabase (פרויקט נפרד מומלץ) ---
LL_SUPABASE_URL=https://xxxx.supabase.co
LL_SUPABASE_SERVICE_ROLE_KEY=

# --- כניסת מנהל (נוצר ע"י npm run setup-admin) ---
LL_ADMIN_PASSWORD_HASH=
LL_TOTP_SECRET=
LL_SESSION_SECRET=
# העלאת המספר מנתקת מיד את כל המחוברים
LL_SESSION_VERSION=1
